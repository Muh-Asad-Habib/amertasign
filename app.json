{
  "expo": {
    "name": "Amerta Sign",
    "slug": "amertaSign",
    "scheme": "amertasign",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.devnolife.amertasign",
      "versionCode": 1,
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      },
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Amerta Sign membutuhkan akses kamera untuk menerjemahkan bahasa isyarat secara langsung."
        }
      ],
      "expo-secure-store",
      "expo-video",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Amerta Sign membutuhkan akses mikrofon untuk mengubah ucapan menjadi teks.",
          "speechRecognitionPermission": "Amerta Sign menggunakan pengenalan suara untuk menerjemahkan ucapan ke bahasa isyarat."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Amerta Sign membutuhkan akses galeri untuk menerjemahkan media bahasa isyarat."
        }
      ],
      "expo-web-browser"
    ]
  }
}
