# Base URL backend FastAPI (tanpa trailing slash).
# Dev: kosongkan agar otomatis memakai host Metro (http://<host-dev>:8000).
# Build APK/production: WAJIB diisi URL backend yang bisa diakses dari device.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8000

# Login/Daftar dengan Google — alur web via backend (lihat docs/google-login-setup.md).
# Konfigurasi client ID/secret ada di SERVER (AMERTASIGN_GOOGLE_CLIENT_IDS,
# AMERTASIGN_GOOGLE_CLIENT_SECRET, AMERTASIGN_PUBLIC_BASE_URL) — app tidak butuh env Google.
# Variabel di bawah hanya dipakai bila nanti beralih ke OAuth client Android native.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

